# --- Database (Neon) -------------------------------------------------------
# Neon connection string, pooled endpoint. https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/diary?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app. No trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (Phase 1) ------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (Phase 1, password reset) -------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Diary <diary@example.com>"
